		Items: {
			BlazingLightBalloonBundle: {
				DisplayName: 狐火灵球
				Tooltip:
					'''
					“四颗注入了妖狐迅捷之力的灵珠”
					允许持有者四连跳
					增加移动加速度和跳跃高度，使坠落伤害无效
					按住下键可以快速下落
					缓慢生成最多3个灵焰，允许你消耗灵焰向光标处冲刺
					按下“饰品能力”键进行冲刺
					装备时视为翅膀
					'''
			}

			BoneCovenant: {
				DisplayName: 骸骨圣约
				Tooltip:
					'''
					用暗能量增幅一些光辉攻击
					治疗法术会降低1点治疗量
					使用光辉武器额外消耗1点生命
					使用光辉武器持续获得堕落充能
					堕落充能最多提升10点光辉伤害
					'''
			}

			CursedCovenant: {
				DisplayName: 诅咒圣约
				Tooltip:
					'''
					用暗能量增幅一些光辉攻击
					使用光辉武器额外消耗1点生命
					使用光辉武器持续获得堕落充能
					堕落充能最多提升5点光辉伤害
					'''
			}

			EternalBulwark: {
				DisplayName: 永恒壁垒
				Tooltip:
					'''
					对击退免疫
					当生命值高于25%时，吸收团队中玩家所受伤害的25%
					敌人更有可能瞄准你
					增加你的生命再生速率
					低于25%生命值时受到伤害会在你周围环绕一个保护性泡泡
					在泡泡中时，你每秒会恢复与治疗加成+5相同的生命值并降低25%受到的伤害
					泡泡还能使你在15秒内完全抵消1次受到的伤害
					此效果只能每45秒触发1次
					'''
			}

			FallenCovenant: {
				DisplayName: 堕落圣约
				Tooltip:
					'''
					用暗能量增幅一些光辉攻击
					治疗法术会降低1点治疗量
					使用光辉武器额外消耗2点生命
					使用光辉武器持续获得堕落充能
					堕落充能最多提升12点光辉伤害
					满层堕落充能提供12%光辉伤害和5%光辉暴击率
					'''
			}

			HeresyCovenant: {
				DisplayName: 赫瑞之孽
