		Items: {
			BlazingLightBalloonBundle: {
				DisplayName: Foxfire Spirit Orbs
				Tooltip:
					'''
					"Four spirit orbs infused with the swift power of a fox spirit"
					Allows you to perform a quadruple jump
					Increases movement acceleration and jump height, and negates fall damage
					Hold DOWN to fall quickly
					Slowly generates up to 3 Spirit Flames, allowing you to consume one to dash toward the cursor
					Press the "Accessory Ability" key to dash
					Counts as wings when equipped
					'''
			}

			BoneCovenant: {
				DisplayName: Bone Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Healing spells heal for 1 less life
					Using radiant weapons costs an additional 1 life
					Using radiant weapons steadily accumulates Fallen Charge
					Fallen Charge increases radiant damage by up to 10
					'''
			}

			CursedCovenant: {
				DisplayName: Cursed Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Using radiant weapons costs an additional 1 life
					Using radiant weapons steadily accumulates Fallen Charge
					Fallen Charge increases radiant damage by up to 5
					'''
			}

			EternalBulwark: {
				DisplayName: Eternal Bulwark
				Tooltip:
					'''
					Grants immunity to knockback
					When above 25% life, absorbs 25% of the damage taken by players on your team
					Enemies are more likely to target you
					Increases your life regeneration rate
					When below 25% life, taking damage surrounds you with a protective bubble
					While inside the bubble, you recover life each second equal to your healing bonus +5 and take 25% less damage
					The bubble also completely negates 1 instance of incoming damage within 15 seconds
					This effect can only trigger once every 45 seconds
					'''
			}

			FallenCovenant: {
				DisplayName: Fallen Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Healing spells heal for 1 less life
					Using radiant weapons costs an additional 2 life
					Using radiant weapons steadily accumulates Fallen Charge
					Fallen Charge increases radiant damage by up to 12
					At maximum Fallen Charge, grants 12% radiant damage and 5% radiant critical strike chance
					'''
			}

			HeresyCovenant: {
				DisplayName: Heresy
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Increases radiant damage by 20%
					Increases radiant critical strike chance by 15%
					Healing spells heal for 1 less life
					For every 2 life spent by radiant spells, restores 1 life
					Enemies you hit take 100% increased damage over time from Shadowflame and Cursed Light debuffs
					Enemies afflicted by Shadowflame and Cursed Light take 15% more damage and increase your life regeneration
					'''
			}

			KarmaCovenant: {
				DisplayName: Karma Covenant
				Tooltip:
					'''
					Every 100 healing in your healing streak fuels an ancient crucible, up to 500 total
