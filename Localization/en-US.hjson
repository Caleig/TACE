Mods: {
	ThoriumAccessoryExpansion: {
		Buffs: {
			UnholyKarma: {
				Description: Take 10% more damage
				DisplayName: Unholy Karma
			}

			LifeReganBuff: {
				Description: Rapidly regenerating life
				DisplayName: Life Regan Buff
			}

			EternalBulwarkAbsorbBuff: {
				Description: Redirecting damage
				DisplayName: Eternal Bulwark Absorb Buff
			}

			DefenseBuff: {
				Description: Take 25% less damage, life regenerates rapidly
				DisplayName: Defense Buff
			}

			LifeDrainCooldown: {
				Description: Prevents the covenant from triggering multiple times in a single attack
				DisplayName: Life Drain Cooldown
			}

			SupremeWrath: {
				DisplayName: Supreme Wrath
				Description: Attacking this target grants +1 Soul Essence
			}
		}

		Items: {
			BlazingLightBalloonBundle: {
				DisplayName: Blazing Light Balloon Bundle
				Tooltip:
					'''
					"Four spirit orbs infused with the swift power of a fox spirit"
					Grants the ability to perform a quadruple jump
					Increases movement acceleration and jump height, and negates fall damage
					Hold DOWN to fall quickly
					Slowly generates up to 3 spirit flames, letting you consume one to dash toward the cursor
					Press 'Accessory Ability' key to dash
					Counts as wings when equipped
					'''
			}

			BoneCovenant: {
				DisplayName: Bone Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Healing spells heal 1 less life
					Using radiant weapons costs an additional 1 life
					Using radiant weapons steadily accumulates Fallen Charge
					Fallen Charge increases radiant damage by up to 10
					'''
			}

			CursedCovenant: {
				DisplayName: Cursed Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Using radiant weapons costs an additional 1 life
					Using radiant weapons steadily accumulates Fallen Charge
					Fallen Charge increases radiant damage by up to 5
					'''
			}

			EternalBulwark: {
				DisplayName: Eternal Bulwark
				Tooltip:
					'''
					Grants immunity to knockback
					Absorbs 25% of damage done to players on your team when above 25% life
					Enemies are more likely to target you
					Increases your life regeneration speed
					While below 25% life, taking damage surrounds you with a protective bubble
					While inside the bubble, you recover life each second equal to a +5 healing bonus and take 25% less damage
					The bubble also fully negates 1 instance of incoming damage over 15 seconds
					This effect can only trigger once every 45 seconds
					'''
			}

			FallenCovenant: {
				DisplayName: Fallen Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Healing spells heal 1 less life
					Using radiant weapons costs an additional 2 life
					Using radiant weapons steadily accumulates Fallen Charge
					Fallen Charge increases radiant damage by up to 12
					At maximum Fallen Charge, grants 12% radiant damage and 5% radiant critical strike chance
					'''
			}

			HeresyCovenant: {
				DisplayName: Heresy Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Increases radiant damage by 20%
					Increases radiant critical strike chance by 15%
					Healing spells heal 1 less life
					For every 2 life spent by radiant spells, restores 1 life
					Enemies you hit take 100% increased damage over time from Shadowflame and Cursed Light debuffs
					Enemies afflicted by Shadowflame and Cursed Light take 15% more damage and increase your own life regeneration
					'''
			}

			KarmaCovenant: {
				DisplayName: Karma Covenant
				Tooltip:
					'''
					Your healing streak fuels an ancient crucible every 100 life up to 500 total
					The crucible increases your radiant damage by 8% per 100 life in the crucible
					Empowers certain radiant attacks with dark energy
					Using radiant weapons costs an additional 3 life
					Using radiant weapons steadily accumulates Fallen Charge
					Fallen Charge increases radiant damage by up to 15
					At maximum Fallen Charge, grants 15% radiant damage and 8% radiant critical strike chance
					At maximum Fallen Charge, the healing from Soul Essence is shared with nearby teammates
					'''
			}

			MichaelasAid: {
				DisplayName: Michaelas Aid
				Tooltip:
					'''
					"Quis ut Deus? — and the heavens answer."
					Empowers your radiant attacks with holy energy
					Enemies you hit grant you more Soul Essence
					Grants comprehensive radiant bonuses based on your bonus healing
					Increases maximum health and mana by 10
					Increases healing speed by 20%
					Healing spells heal an additional 2 life
					'''
			}

			SpiritBlade: {
				DisplayName: Spirit Blade
				Tooltip:
					'''
					+5 magic damage
					Allows the Magic Sword to pierce through 2 enemies
					'''
			}

			MagicSheath: {
				Tooltip:
					'''
					15 basic magic damage
					Consuming mana has a low chance to summon 1 Magic Sword
					Flies toward the cursor when mana falls below 25%
					Magic Sword hits restore 10% of your maximum mana
					Up to 2 Magic Swords can exist at once
					Each active sword increases mana costs by 5%
					'''
				DisplayName: Magic Sheath
			}

			SpiritMagicSheath: {
				DisplayName: Spirit Magic Sheath
				Tooltip:
					'''
					30 basic magic damage
					Consuming mana has a medium chance to summon 1 Magic Sword
					Flies toward the cursor when mana falls below 30%
					Magic Sword hits restore 15% of your maximum mana
					Up to 3 Magic Swords can exist at once
					Each active sword increases mana costs by 5% and magic damage by 3
					'''
			}

			TerraMagicSheath: {
				DisplayName: Terra Magic Sheath
				Tooltip:
					'''
					+15% magic damage
					Magic Swords deal 50% of the held weapon's damage
					Consuming mana has a high chance to summon 1 Terra Magic Sword
					Flies toward the cursor and homes in on enemies when mana falls below 35%
					Magic Sword hits restore 15% of your maximum mana
					Up to 4 Terra Magic Swords can exist at once
					Each active sword increases magic damage by 4, defense by 3, and mana costs by 5%
					'''
			}

			BlazingScroll: {
				DisplayName: Blazing Scroll
				Tooltip: Magic Sword hits deal area damage and ignite enemies
			}

			EnergyScroll: {
				DisplayName: Energy Scroll
				Tooltip:
					'''
					Magic Sword hits infuse enemies with granite energy
					Infused enemies take 5% increased damage
					'''
			}

			GeodeScroll: {
				DisplayName: Geode Scroll
				Tooltip:
					'''
					Magic Sword hits sunder enemies
					Sundered enemies take 10% increased damage
					'''
			}

			HolyScroll: {
				DisplayName: Holy Scroll
				Tooltip:
					'''
					Magic Sword hits ignite enemies with Holy Glare
					Enemies afflicted with Holy Glare take 15% increased damage
					'''
			}

			SoulScroll: {
				DisplayName: Soul Scroll
				Tooltip: Magic Sword hits drain life from enemies
			}

			HellstoneGunMod: {
				DisplayName: Hellstone Gun Modification
				Tooltip:
					'''
					Gun critical strike chance increased by 5%
					Gun attack speed increased by 5%
					Gun attacks build heat (1 per attack, max 100)
					At full heat: attack speed +10%, attacks consume 2 heat, deal 5 bonus damage (cannot crit) and apply Hellfire
					Heat only builds again after fully spent
					'''
			}

			GreenDragonGunMod: {
				DisplayName: Green Dragon Gun Modification
				Tooltip:
					'''
					Gun critical strike chance increased by 12%
					Gun attack speed increased by 8%
					Gun attacks build heat (1 per attack, max 100)
					At full heat: attacks consume 1 heat, deal 10 bonus damage (cannot crit) and apply Cursed Inferno
					Heat only builds again after fully spent
					'''
			}

			FleshGunMod: {
				DisplayName: Flesh Gun Modification
				Tooltip:
					'''
					Gun critical strike chance increased by 8%
					Gun attack speed increased by 12%
					Gun attacks build heat (1 per attack, max 100)
					At full heat: attacks consume 1 heat, deal 6 bonus damage (cannot crit) and apply Ichor
					Heat only builds again after fully spent
					'''
			}

			TitanGunMod: {
				DisplayName: Titan Gun Modification
				Tooltip:
					'''
					Take 25% more damage
					Gun attack speed reduced by 30%
					Guns with a base use time below 30 deal 75% more damage
					Critical strikes deal 300% damage
					'''
			}

			FleshTrigger: {
				DisplayName: Flesh Trigger
				Tooltip:
					'''
					Gun attack speed increased by 20%
					Gun attacks build heat (2 per attack, max 150)
					At full heat: attacks consume 1 heat and deal 10 bonus damage (can crit)
					Heat only builds again after fully spent
					Counts as a gun modification
					'''
			}

			DreadQuiver: {
				DisplayName: Dread Quiver
				Tooltip:
					'''
					Arrow damage increased by 15%
					Ranged critical strike chance increased by 8%
					25% chance to not consume arrows
					Arrow velocity greatly increased
					Arrows copy 15% of their damage on hit
					Enemies are less likely to target you
					'''
			}

