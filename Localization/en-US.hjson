		Items: {
			BlazingLightBalloonBundle: {
				DisplayName: Foxfire Spirit Orbs
				Tooltip:
					'''
					'Four orbs imbued with the swiftness of a fox spirit'
					Grants four extra jumps
					Increases movement acceleration and jump height, and negates fall damage
					Increases fall speed when holding DOWN
					Slowly generates up to 3 spirit flames, which let you dash toward your cursor
					Press the '{$Mods.ThoriumMod.Keybinds.AccessoryAbility.DisplayName}' key to dash
					Counts as a pair of wings when equipped
					'''
			}

			BoneCovenant: {
				DisplayName: Bone Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Healing spells will heal 1 less life
					Using a radiant weapon costs 1 extra life
					Using radiant weapons steadily builds Fallen Charge
					Fallen Charge grants up to +10 flat radiant damage
					'''
			}

			CursedCovenant: {
				DisplayName: Cursed Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Using a radiant weapon costs 1 extra life
					Using radiant weapons steadily builds Fallen Charge
					Fallen Charge grants up to +5 flat radiant damage
					'''
			}

			EternalBulwark: {
				DisplayName: Eternal Bulwark
				Tooltip:
					'''
					Grants immunity to knockback
					Absorbs 25% of damage done to players on your team when above 25% life
					Enemies are more likely to target you
					Increases the rate at which you regenerate life
					Receiving damage below 25% life surrounds you in a protective bubble
					While bubbled, gain life recovery equal to your bonus healing + 5 and 25% damage resistance
					The bubble also negates the next hit you take within 15 seconds
					This effect can only trigger every 45 seconds
					'''
			}

			FallenCovenant: {
				DisplayName: Fallen Covenant
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					Healing spells will heal 1 less life
					Using a radiant weapon costs 2 extra life
					Using radiant weapons steadily builds Fallen Charge
					Fallen Charge grants up to +12 flat radiant damage
					At full Fallen Charge, gain 12% increased radiant damage and 5% increased radiant critical strike chance
					'''
			}

			HeresyCovenant: {
				DisplayName: Sin of Heresy
				Tooltip:
					'''
					Empowers certain radiant attacks with dark energy
					20% increased radiant damage
					15% increased radiant critical strike chance
					Healing spells will heal 1 less life
					Radiant spells refund 1 life for every 2 life they cost
					Enemies you hit take 100% more damage from Shadowflame and Light Curse damage over time
					Enemies afflicted with Shadowflame or Light Curse take 15% more damage and increase your life regeneration
					'''
			}

			KarmaCovenant: {
				DisplayName: Karmic Covenant
				Tooltip:
					'''
					Your healing streak fuels an ancient crucible every 100 life up to 500 total
					The crucible increases your radiant damage by 8% per 100 life in the crucible
					Empowers certain radiant attacks with dark energy
					Using a radiant weapon costs 3 extra life
					Using radiant weapons steadily builds Fallen Charge
					Fallen Charge grants up to +15 flat radiant damage
					At full Fallen Charge, gain 15% increased radiant damage and 8% increased radiant critical strike chance
					At full Fallen Charge, healing from soul essence is shared with nearby allies
					'''
			}

			MichaelasAid: {
				DisplayName: Michael's Aid
				Tooltip:
					'''
					'Who is like God?'
					Empowers your radiant attacks with holy energy
					Enemies you hit grant you more soul essence
					Your bonus healing also boosts your radiant damage, critical strike chance and attack speed
					Maximum life & mana increased by 10
