			AmethystContract: {
				DisplayName: Amethyst Contract
				Tooltip:
					'''
					Amethyst seeks and tracks its prey.

					Converts the held magic weapon into summon damage, with base damage equal to 65% of the weapon's displayed damage.
					Hits apply "Amethyst Mark" for 5 seconds.
					Only one Contract Mark can exist at a time; applying a new mark replaces the existing one.

					When a minion or sentry attacks a target with "Amethyst Mark":
					Consumes the mark and triggers an explosion dealing 50% of the triggering attack's actual damage.
					Also releases a homing Amethyst Bolt dealing 100% of the weapon damage when the mark was applied.
					'''
			}

			TopazContract: {
				DisplayName: Topaz Contract
				Tooltip:
